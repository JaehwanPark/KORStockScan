[Unit]
Description=KORStockScan Samsung One-Share PREOPEN Authority Gate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
# Runtime-env verification reads /proc/<bot-pid>/environ.  Keep the
# verifier's fs credentials aligned with bot_main.py; a different primary
# group makes the same-UID procfs read fail closed on this host.
Group=ubuntu
WorkingDirectory=/home/ubuntu/KORStockScan
ExecStart=/home/ubuntu/KORStockScan/deploy/run_samsung_morning_one_share_preflight.sh
TimeoutStartSec=5400
UMask=0077
Nice=5
CPUQuota=10%
MemoryMax=256M
TasksMax=32
NoNewPrivileges=true
