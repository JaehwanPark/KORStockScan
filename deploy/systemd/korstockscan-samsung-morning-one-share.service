[Unit]
Description=KORStockScan Samsung Morning Two-Episode Live Machine
After=network-online.target korstockscan-samsung-one-share-preflight.service
Wants=network-online.target
Requires=korstockscan-samsung-one-share-preflight.service
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=ubuntu
# validate_authority(require_live_main_bot_runtime=True) rechecks the bound
# bot PID environment, so the live consumer needs the same procfs credentials
# as the preflight and bot_main.py.
Group=ubuntu
WorkingDirectory=/home/ubuntu/KORStockScan
Environment="PYTHONPATH=/home/ubuntu/KORStockScan"
Environment="KORSTOCKSCAN_SAMSUNG_MORNING_ONE_SHARE_ENABLED=true"
Environment="KORSTOCKSCAN_WIDGET_EPISODE_MARKET_WEAKNESS_ENTRY_GUARD_ENABLED=1"
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.trading.samsung_morning_one_share.service --live --confirm 005930_MORNING_TWO_EPISODE_LIVE --interval-sec 2
Restart=on-failure
RestartPreventExitStatus=4 5 6
RestartSec=5
UMask=0077
Nice=5
CPUQuota=10%
MemoryMax=256M
TasksMax=32
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
