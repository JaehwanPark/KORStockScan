[Unit]
Description=KORStockScan Unattended Exact-Date Symbol Owner Policy Apply
After=network-online.target
Wants=network-online.target
Before=korstockscan-widget-signal-auto-trader.service korstockscan-samsung-morning-one-share.service korstockscan-samsung-midday-one-share.service korstockscan-samsung-afternoon-one-share.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/ubuntu/KORStockScan
ExecStart=/home/ubuntu/KORStockScan/deploy/run_symbol_owner_policy_auto_apply.sh
TimeoutStartSec=1200
UMask=0077
