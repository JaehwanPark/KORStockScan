[Unit]
Description=KORStockScan Widget and Episode Confirmed Fill Telegram Notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan-runtime-releases/machine-fill-telegram-20260911
Environment="PYTHONPATH=/home/ubuntu/KORStockScan-runtime-releases/machine-fill-telegram-20260911"
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.notify.machine_trade_telegram --registry /home/ubuntu/KORStockScan/data/runtime/order_owner_registry.jsonl --state /home/ubuntu/KORStockScan/data/runtime/machine_fill_telegram/state.json --account-key kiwoom-live-primary
Restart=on-failure
RestartSec=30
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=128M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/KORStockScan/data/runtime/machine_fill_telegram

[Install]
WantedBy=multi-user.target
