[Unit]
Description=KORStockScan Machine Microstructure Final Refresh
After=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=6

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
Environment="PYTHONPATH=/home/ubuntu/KORStockScan"
ExecStart=/home/ubuntu/KORStockScan/deploy/run_machine_microstructure_final_refresh.sh
TimeoutStartSec=57600
Restart=no
RestartSec=300
RestartPreventExitStatus=42 75
Nice=10
CPUQuota=20%
MemoryMax=2G
TasksMax=64
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
