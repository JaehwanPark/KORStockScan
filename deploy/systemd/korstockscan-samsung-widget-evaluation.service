[Unit]
Description=KORStockScan Samsung Widget Advisory Daily Evaluation
After=korstockscan-samsung-widget-collector.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
Environment="PYTHONPATH=/home/ubuntu/KORStockScan"
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.engine.monitoring.samsung_widget_advisory_evaluation --write
NoNewPrivileges=true
PrivateTmp=true
