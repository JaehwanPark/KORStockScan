[Unit]
Description=KORStockScan Multi-Symbol Widget Advisory Daily Calibration
After=korstockscan-samsung-widget-collector.service korstockscan-doosan-widget-collector.service korstockscan-hanwha-ocean-widget-collector.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
Environment="PYTHONPATH=/home/ubuntu/KORStockScan"
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.engine.monitoring.widget_advisory_calibration --write
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.engine.monitoring.widget_auto_trade_policy_calibration --write
Nice=10
CPUQuota=20%
MemoryMax=512M
TasksMax=64
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
