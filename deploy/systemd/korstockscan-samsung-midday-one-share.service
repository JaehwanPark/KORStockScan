[Unit]
Description=KORStockScan Samsung Midday One-Share Live Machine
After=network-online.target korstockscan-samsung-midday-one-share-preflight.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
Environment="PYTHONPATH=/home/ubuntu/KORStockScan"
Environment="KORSTOCKSCAN_SAMSUNG_MIDDAY_ONE_SHARE_ENABLED=true"
Environment="KORSTOCKSCAN_WIDGET_EPISODE_MARKET_WEAKNESS_ENTRY_GUARD_ENABLED=1"
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.trading.samsung_midday_one_share.service --live --confirm 005930_MIDDAY_TWO_LEG_LIVE --interval-sec 2
Restart=on-failure
RestartSec=5
UMask=0077
Nice=5
CPUQuota=10%
MemoryMax=256M
TasksMax=32
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
