[Unit]
Description=KORStockScan Lower-Price Two-Leg Live Machine (%i)
After=network-online.target korstockscan-symbol-owner-policy-auto-apply.service korstockscan-low-price-two-leg-preflight@%i.service
Wants=network-online.target
Requires=korstockscan-low-price-two-leg-preflight@%i.service
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
EnvironmentFile=-/home/ubuntu/KORStockScan/data/runtime/symbol_owner_policy/owner_custody.env
Environment="KORSTOCKSCAN_WIDGET_EPISODE_MARKET_WEAKNESS_ENTRY_GUARD_ENABLED=1"
ExecStart=/home/ubuntu/KORStockScan/deploy/run_low_price_two_leg_live.sh %i
Restart=on-failure
RestartPreventExitStatus=4 5
RestartSec=5
UMask=0077
Nice=5
CPUQuota=10%
MemoryMax=256M
TasksMax=32
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
