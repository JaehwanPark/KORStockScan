[Unit]
Description=KORStockScan Samsung Midday One-Share Same-Day Preflight
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
ExecStart=/home/ubuntu/KORStockScan/deploy/run_samsung_midday_one_share_preflight.sh
TimeoutStartSec=180
UMask=0077
Nice=5
CPUQuota=10%
MemoryMax=256M
TasksMax=32
NoNewPrivileges=true
