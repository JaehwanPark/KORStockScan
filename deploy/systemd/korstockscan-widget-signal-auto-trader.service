[Unit]
Description=KORStockScan Operator-Directed Widget Signal Auto Trader
After=network-online.target korstockscan-samsung-widget-collector.service korstockscan-doosan-widget-collector.service korstockscan-hanwha-ocean-widget-collector.service korstockscan-widget-symbol-runtime-collector.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/KORStockScan
Environment="PYTHONPATH=/home/ubuntu/KORStockScan"
Environment="KORSTOCKSCAN_WIDGET_AUTO_TRADER_ENABLED=true"
Environment="KORSTOCKSCAN_WIDGET_EPISODE_MARKET_WEAKNESS_ENTRY_GUARD_ENABLED=1"
Environment="KORSTOCKSCAN_WIDGET_AUTO_TRADER_ENTRY_QTY=10"
Environment="KORSTOCKSCAN_WIDGET_AUTO_TRADER_SYMBOLS=005930,034020,042660"
Environment="KORSTOCKSCAN_WIDGET_AUTO_TRADER_SAMSUNG_EXECUTION_POLICY=SAMSUNG_EQUAL_10_ADD0P5_ADD1P0_TP0P5_V2"
Environment="KORSTOCKSCAN_WIDGET_AUTO_TRADER_ENTRY_TELEGRAM_ENABLED=true"
ExecStart=/home/ubuntu/KORStockScan/.venv/bin/python -m src.trading.widget_auto_trade.service --interval-sec 1
Restart=on-failure
RestartSec=3
UMask=0077
Nice=5
CPUQuota=10%
MemoryMax=256M
TasksMax=32
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
